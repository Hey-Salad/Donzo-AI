# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_SECRET_KEY=generate-a-secure-random-key
PORT=5000

# Monzo API Credentials
MONZO_CLIENT_ID=your_monzo_client_id
MONZO_CLIENT_SECRET=your_monzo_client_secret
MONZO_REDIRECT_URI=http://localhost:5000/callback
MONZO_USER_ID=your_monzo_user_id
MONZO_ACCOUNT_ID=your_monzo_account_id
MONZO_ACCESS_TOKEN=your_access_token_if_available

# Azure OpenAI Settings
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_ASSISTANT_ID=your_assistant_id_if_using

# Azure Speech Service Settings
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_SPEECH_REGION=your_region

